# Copy to .env for local / loop-mode runs. .env is git-ignored.
# Use a separate test channel while trialling so it doesn't double up with the GitHub monitor.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_BOARD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_PING=<@YOUR_USER_ID>
# INCLUDE_ACCESSORIES=true

# Target (python monitor.py --retailer target). Each TARGET_ setting falls back to the plain one above.
# TARGET_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TARGET_DISCORD_BOARD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TARGET_INCLUDE_ACCESSORIES=true
